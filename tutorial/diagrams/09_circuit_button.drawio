<mxfile host="app.diagrams.net" type="device">
  <diagram name="Button circuit" id="circuit_button">
    <mxGraphModel dx="1000" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Button circuit&lt;/b&gt;  —  a push switch (GPIO 26)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="520" height="34" as="geometry" />
        </mxCell>

        <!-- ESP32 with internal pull-up shown -->
        <mxCell id="esp" value="ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#30363d;strokeColor=#111;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="rail" value="3.3 V (inside)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="120" height="24" as="geometry" />
        </mxCell>
        <!-- internal pull-up resistor (dashed = inside the chip) -->
        <mxCell id="pu" value="internal&#10;pull-up&#10;resistor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="96" y="182" width="88" height="60" as="geometry" />
        </mxCell>
        <mxCell id="puw1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="164" as="sourcePoint" /><mxPoint x="140" y="182" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="puw2" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#d6b656;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="242" as="sourcePoint" /><mxPoint x="140" y="286" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="pinGPIO" value="GPIO 26 (input)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd966;strokeColor=#bf9000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="273" width="90" height="26" as="geometry" />
        </mxCell>
        <mxCell id="junction" value="" style="ellipse;html=1;fillColor=#444;strokeColor=#444;" vertex="1" parent="1">
          <mxGeometry x="135" y="281" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="jw" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="286" as="sourcePoint" /><mxPoint x="270" y="286" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- wire GPIO26 out to the button -->
        <mxCell id="w1" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="286" as="sourcePoint" /><mxPoint x="470" y="286" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- push button (SPST switch symbol) -->
        <mxCell id="bt1" value="" style="ellipse;html=1;fillColor=#444;strokeColor=#444;" vertex="1" parent="1">
          <mxGeometry x="466" y="281" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="lever" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="471" y="286" as="sourcePoint" /><mxPoint x="520" y="262" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="bt2" value="" style="ellipse;html=1;fillColor=#444;strokeColor=#444;" vertex="1" parent="1">
          <mxGeometry x="521" y="281" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="btlabel" value="push button&#10;(closes the gap when pressed)" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="420" y="220" width="170" height="34" as="geometry" />
        </mxCell>

        <!-- wire button -> down -> ground -->
        <mxCell id="w2" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="526" y="286" as="sourcePoint" /><mxPoint x="600" y="360" as="targetPoint" />
            <Array as="points"><mxPoint x="600" y="286"/></Array>
          </mxGeometry>
        </mxCell>
        <!-- ground symbol -->
        <mxCell id="gnd_v" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="360" as="sourcePoint" /><mxPoint x="600" y="374" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="gnd_b1" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="374" as="sourcePoint" /><mxPoint x="620" y="374" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="gnd_b2" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="587" y="382" as="sourcePoint" /><mxPoint x="613" y="382" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="gnd_b3" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="593" y="390" as="sourcePoint" /><mxPoint x="607" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="gndlabel" value="GND (0 V)" style="text;html=1;align=left;fontSize=10;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="626" y="368" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- reading labels -->
        <mxCell id="readup" value="NOT pressed → pin sits at 3.3 V → reads HIGH (1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f1;strokeColor=#e5534b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="readdown" value="pressed → connects pin to GND → reads LOW (0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="158" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- physics callout -->
        <mxCell id="phys" value="⚡ &lt;b&gt;Physics:&lt;/b&gt; an input pin measures voltage. Left alone, a bare wire &quot;floats&quot; and picks up electrical noise — random 1s and 0s. The &lt;b&gt;pull-up resistor&lt;/b&gt; (we turn on the ESP32's built-in one with Pin.PULL_UP) gently ties the pin to 3.3 V, so it reads a steady HIGH. Pressing the button shorts the pin straight to GND (0 V), which wins, so it reads LOW. That's why the button is &lt;b&gt;active-low&lt;/b&gt;: pressed = 0. (A press bounces for a few ms, so the code &quot;debounces&quot; it.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4a90d9;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="760" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
