<mxfile host="app.diagrams.net" type="device">
  <diagram name="Sync vs Async" id="sync_vs_async">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Sync vs Async — the heartbeat test&lt;/b&gt;&#10;(async_demo.py) a heartbeat LED blinks while a 2-second &quot;slow job&quot; runs" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="600" height="52" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="♥ = one heartbeat blink" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- ============ SYNC ROW ============ -->
        <mxCell id="synclbl" value="&lt;b&gt;USE_ASYNC = False&lt;/b&gt;&#10;(sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- beats before -->
        <mxCell id="sb1" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="125" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="sb2" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="125" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="sb3" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="125" width="30" height="40" as="geometry" /></mxCell>

        <!-- slow job block (freeze) -->
        <mxCell id="sjob" value="SLOW JOB — blocks for 2 s&#10;(the loop is stuck here)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="freezelbl" value="❄ LED frozen — no beats" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="172" width="260" height="18" as="geometry" />
        </mxCell>

        <!-- beats after -->
        <mxCell id="sb4" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="sb5" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="sb6" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="125" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="sb7" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="710" y="125" width="30" height="40" as="geometry" /></mxCell>

        <mxCell id="syncverdict" value="⏸ time.sleep(2) blocks the ONE loop → the beat stops → the LED visibly FREEZES." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#8a3a34;" vertex="1" parent="1">
          <mxGeometry x="180" y="200" width="620" height="20" as="geometry" />
        </mxCell>

        <!-- ============ ASYNC ROW ============ -->
        <mxCell id="asynclbl" value="&lt;b&gt;USE_ASYNC = True&lt;/b&gt;&#10;(async)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- continuous beats -->
        <mxCell id="ab1" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab2" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab3" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab4" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab5" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab6" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab7" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab8" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="510" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab9" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab10" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab11" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="305" width="30" height="40" as="geometry" /></mxCell>
        <mxCell id="ab12" value="♥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="710" y="305" width="30" height="40" as="geometry" /></mxCell>

        <!-- slow job runs underneath, concurrently -->
        <mxCell id="ajob" value="slow job — awaits 2 s (yields, runs in the background)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0e0;strokeColor=#82b366;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="360" width="330" height="34" as="geometry" />
        </mxCell>

        <mxCell id="asyncverdict" value="✅ await asyncio.sleep(2) YIELDS → the heartbeat task keeps running → the LED stays SMOOTH." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#3a6b35;" vertex="1" parent="1">
          <mxGeometry x="180" y="404" width="620" height="20" as="geometry" />
        </mxCell>

        <!-- time axis -->
        <mxCell id="timeaxis" value="time →" style="html=1;endArrow=block;strokeColor=#999999;fontSize=11;fontColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="450" as="sourcePoint" /><mxPoint x="760" y="450" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- footer -->
        <mxCell id="footer" value="Same job, two ways to wait. Async isn't &quot;faster&quot; — it stops one slow wait from freezing everything else, but ONLY if that wait can yield (await). In the real firmware urequests blocks even under async, so sync is the right default there." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="840" height="56" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
