<mxfile host="app.diagrams.net" type="device">
  <diagram name="HTTP and the Server" id="http_server">
    <mxGraphModel dx="1422" dy="754" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;How a Client Talks to a Server&lt;/b&gt;&#10;HTTP requests, responses, and what a 'server' really is" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- =================================================== -->
        <!-- SECTION 1: HTTP is a conversation                   -->
        <!-- =================================================== -->
        <mxCell id="s1head" value="1️⃣  HTTP is a conversation: one REQUEST, one RESPONSE" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="980" height="34" as="geometry" />
        </mxCell>

        <!-- Client + Server -->
        <mxCell id="client" value="💻 &lt;b&gt;Client&lt;/b&gt;&#10;(your browser,&#10;or an ESP32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="server" value="🐍 &lt;b&gt;Server&lt;/b&gt;&#10;(Flask app.py&#10;on the laptop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="860" y="220" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- REQUEST card -->
        <mxCell id="reqCard" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="reqTitle" value="📤 &lt;b&gt;REQUEST&lt;/b&gt;  (client → server: &quot;please do this&quot;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="154" width="480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="reqBody" value="POST /api/houses              ← method + path (what + where)&#10;Content-Type: application/json   ← a header (extra info)&#10;&#10;{&quot;unique_id&quot;: &quot;FAKE001&quot;}        ← the body (the data)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="312" y="178" width="486" height="78" as="geometry" />
        </mxCell>

        <!-- request arrow -->
        <mxCell id="reqArrow" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#d6b656;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="client" target="server">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- RESPONSE card -->
        <mxCell id="respCard" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="respTitle" value="📥 &lt;b&gt;RESPONSE&lt;/b&gt;  (server → client: &quot;here's what happened&quot;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="294" width="480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="respBody" value="201 Created                   ← status code (did it work?)&#10;Content-Type: application/json&#10;&#10;{&quot;ok&quot;: true, &quot;unique_id&quot;: &quot;FAKE001&quot;}   ← the body (the answer)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="312" y="318" width="486" height="68" as="geometry" />
        </mxCell>

        <!-- response arrow -->
        <mxCell id="respArrow" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="server" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Restaurant analogy -->
        <mxCell id="analogy" value="📚 &lt;b&gt;Think of the school library.&lt;/b&gt;  You fill out a request slip with the exact call number — say &lt;b&gt;QA76.73&lt;/b&gt; (the REQUEST). The librarian disappears into the stacks and brings back your book (the RESPONSE). You don't wander the shelves yourself — you ask and receive. Call number for a book that doesn't exist? &lt;b&gt;404 Not Found&lt;/b&gt;. Slip with no call number written on it? &lt;b&gt;400 Bad Request&lt;/b&gt;. The librarian brings a book and a date stamp — no small talk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="405" width="940" height="60" as="geometry" />
        </mxCell>

        <!-- =================================================== -->
        <!-- SECTION 2: status codes                             -->
        <!-- =================================================== -->
        <mxCell id="s2head" value="2️⃣  The status code tells you what happened" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="485" width="980" height="34" as="geometry" />
        </mxCell>

        <mxCell id="code200" value="✅ &lt;b&gt;200 OK&lt;/b&gt;&#10;It worked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="535" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="code201" value="✅ &lt;b&gt;201 Created&lt;/b&gt;&#10;Made a new thing (a house registered)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="535" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="code400" value="⚠️ &lt;b&gt;400 Bad Request&lt;/b&gt;&#10;You sent something wrong (missing data)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="535" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="code404" value="❌ &lt;b&gt;404 Not Found&lt;/b&gt;&#10;That thing doesn't exist (unknown house)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="535" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- =================================================== -->
        <!-- SECTION 3: the server is a loop                     -->
        <!-- =================================================== -->
        <mxCell id="s3head" value="3️⃣  A &quot;server&quot; is just a program stuck in a loop, waiting for requests" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="615" width="980" height="34" as="geometry" />
        </mxCell>

        <mxCell id="loop1" value="👂 &lt;b&gt;1. Listen&lt;/b&gt;&#10;Wait on port 8080&#10;(do nothing until&#10;someone knocks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loop2" value="📨 &lt;b&gt;2. Receive&lt;/b&gt;&#10;A request arrives&#10;(method + path&#10;+ body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loop3" value="🧭 &lt;b&gt;3. Match&lt;/b&gt;&#10;Find the route&#10;whose path fits&#10;→ call its function" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="680" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loop4" value="⚙️ &lt;b&gt;4. Run&lt;/b&gt;&#10;The function reads/&#10;writes the HOUSES&#10;dict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="680" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loop5" value="📤 &lt;b&gt;5. Respond&lt;/b&gt;&#10;Send back status&#10;code + JSON body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="830" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- loop arrows -->
        <mxCell id="la1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="loop1" target="loop2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="la2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="loop2" target="loop3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="la3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="loop3" target="loop4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="la4" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="loop4" target="loop5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- return arrow: respond back to listen -->
        <mxCell id="la5" value="…then go back to waiting (forever)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=1;fontSize=11;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="loop5" target="loop1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="165" y="870" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="loopNote" value="💡 This is literally what app.run() does: an endless loop. When you click 'Stop' in PyCharm, you break the loop and the server shuts down." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="930" width="630" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
