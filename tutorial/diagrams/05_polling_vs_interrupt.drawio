<mxfile host="Electron">
  <diagram name="Polling vs Interrupt" id="poll_vs_irq">
    <mxGraphModel dx="1398" dy="959" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1" value="&lt;b&gt;Two ways to read a button&lt;/b&gt;&#xa;polling (keep asking) vs interrupt (get told)" vertex="1">
          <mxGeometry height="52" width="500" x="210" y="10" as="geometry" />
        </mxCell>
        <mxCell id="pollhdr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;" value="🔁 &lt;b&gt;Polling&lt;/b&gt;  (2_button_poll.py)" vertex="1">
          <mxGeometry height="36" width="360" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=12;" value="check button.value()" vertex="1">
          <mxGeometry height="36" width="180" x="150" y="140" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=11;" value="== 0 ?  (pressed)" vertex="1">
          <mxGeometry height="60" width="180" x="150" y="196" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=12;" value="print(&quot;Pressed!&quot;)" vertex="1">
          <mxGeometry height="34" width="180" x="150" y="276" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=11;" value="time.sleep(0.1)  →  repeat" vertex="1">
          <mxGeometry height="34" width="180" x="150" y="330" as="geometry" />
        </mxCell>
        <mxCell id="pe1" edge="1" parent="1" source="p1" style="html=1;endArrow=block;strokeColor=#d79b00;" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" edge="1" parent="1" source="p2" style="html=1;endArrow=block;strokeColor=#d79b00;fontSize=10;" target="p3" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" edge="1" parent="1" source="p3" style="html=1;endArrow=block;strokeColor=#d79b00;" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" edge="1" parent="1" source="p4" style="html=1;endArrow=block;strokeColor=#d79b00;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;rounded=1;" target="p1" value="loop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="347" />
              <mxPoint x="120" y="158" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pnote" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#8a6d00;" value="The CPU asks ~10×/second, even when nothing happens. And if the loop is busy elsewhere, a quick tap can slip through unnoticed." vertex="1">
          <mxGeometry height="50" width="360" x="60" y="380" as="geometry" />
        </mxCell>
        <mxCell id="irqhdr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;" value="⚡ &lt;b&gt;Interrupt (IRQ)&lt;/b&gt;  (3_button_irq.py / 4_button_led.py)" vertex="1">
          <mxGeometry height="36" width="360" x="500" y="80" as="geometry" />
        </mxCell>
        <mxCell id="i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="button press&#xa;(the hardware notices)" vertex="1">
          <mxGeometry height="46" width="150" x="520" y="140" as="geometry" />
        </mxCell>
        <mxCell id="i2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=11;" value="IRQ handler:&#xa;_pressed = True" vertex="1">
          <mxGeometry height="46" width="150" x="520" y="220" as="geometry" />
        </mxCell>
        <mxCell id="i2note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#b85450;" value="tiny! runs&#xa;instantly" vertex="1">
          <mxGeometry height="40" width="70" x="670" y="196" as="geometry" />
        </mxCell>
        <mxCell id="i3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="main loop&#xa;(free to do other work)" vertex="1">
          <mxGeometry height="46" width="150" x="710" y="140" as="geometry" />
        </mxCell>
        <mxCell id="i4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;" value="if _pressed:&#xa;    do the real work" vertex="1">
          <mxGeometry height="46" width="150" x="710" y="220" as="geometry" />
        </mxCell>
        <mxCell id="ie1" edge="1" parent="1" source="i1" style="html=1;endArrow=block;strokeColor=#82b366;" target="i2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie2" edge="1" parent="1" source="i3" style="html=1;endArrow=block;strokeColor=#6c8ebf;" target="i4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie3" edge="1" parent="1" source="i2" style="html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontSize=10;fontColor=#9673a6;" target="i4" value="reads the flag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inote" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#3a6b35;" value="The hardware fires the handler the instant the pin changes — even mid-loop. The handler just raises a flag; the loop does the real work when it gets to it." vertex="1">
          <mxGeometry height="50" width="360" x="500" y="380" as="geometry" />
        </mxCell>
        <mxCell id="divider" edge="1" parent="1" style="html=1;endArrow=none;strokeColor=#cccccc;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="80" as="sourcePoint" />
            <mxPoint x="460" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" value="🚩 &lt;b&gt;The flag pattern (used everywhere in the real firmware):&lt;/b&gt;  keep the interrupt TINY — just set a flag. Do the real work (toggle the LED, send HTTP, update the LCD) back in the main loop. Never sleep, print, or make network calls inside an interrupt." vertex="1">
          <mxGeometry height="60" width="800" x="60" y="460" as="geometry" />
        </mxCell>
        <mxCell id="foot" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Polling is fine for one simple thing. Interrupts + the flag pattern let the board watch a button, a sensor, and a network all at once without missing anything." vertex="1">
          <mxGeometry height="40" width="800" x="60" y="535" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
