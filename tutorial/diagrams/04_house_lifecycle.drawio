<mxfile host="app.diagrams.net" type="device">
  <diagram name="House Lifecycle" id="house_lifecycle">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;A House's Conversation with the Hub&lt;/b&gt;&#10;register once, then keepalive every second (with an optional state pull)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="160" y="10" width="600" height="56" as="geometry" />
        </mxCell>

        <!-- PHASE BANDS (behind everything) -->
        <mxCell id="band1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=none;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="840" height="120" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eefcf0;strokeColor=none;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="840" height="130" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=none;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="840" height="320" as="geometry" />
        </mxCell>

        <!-- PHASE LABELS -->
        <mxCell id="lbl1" value="1️⃣  REGISTER  (once, at boot)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="52" y="100" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lbl2" value="2️⃣  KEEPALIVE  (every 1 second — the heartbeat)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="52" y="230" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lbl3" value="3️⃣  STATE PULL  (only when the dashboard changed something)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="52" y="370" width="520" height="22" as="geometry" />
        </mxCell>

        <!-- ACTOR HEADERS -->
        <mxCell id="house" value="🏠 &lt;b&gt;House (ESP32)&lt;/b&gt;&#10;app_sync.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="60" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="🐍 &lt;b&gt;Hub (Flask)&lt;/b&gt;&#10;app.py + houses.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="180" height="44" as="geometry" />
        </mxCell>

        <!-- LIFELINES -->
        <mxCell id="ll_house" style="html=1;endArrow=none;dashed=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="104" as="sourcePoint" />
            <mxPoint x="210" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll_hub" style="html=1;endArrow=none;dashed=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="104" as="sourcePoint" />
            <mxPoint x="690" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- TIME AXIS -->
        <mxCell id="timeaxis" value="time" style="html=1;endArrow=block;strokeColor=#999999;fontSize=11;fontColor=#999999;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="120" as="sourcePoint" />
            <mxPoint x="60" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== PHASE 1: REGISTER ===== -->
        <mxCell id="reg_req" value="POST /api/houses&#10;{ unique_id, ip_address }" style="html=1;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="150" as="sourcePoint" />
            <mxPoint x="690" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="reg_resp" value="201 Created&#10;{ ok: true, unique_id }" style="html=1;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="192" as="sourcePoint" />
            <mxPoint x="210" y="192" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== PHASE 2: KEEPALIVE (normal) ===== -->
        <mxCell id="ka_req" value="PUT /api/houses/&lt;uid&gt;/keepalive&#10;{ ip_address }" style="html=1;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="285" as="sourcePoint" />
            <mxPoint x="690" y="285" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ka_resp" value="200 OK&#10;{ alarm: false, state_update: false }" style="html=1;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="327" as="sourcePoint" />
            <mxPoint x="210" y="327" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ka_note" value="nothing changed → carry on.&#10;(repeats every 1 s, forever)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="333" width="300" height="20" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 3: STATE PULL ===== -->
        <!-- side event: dashboard clicked -->
        <mxCell id="dash_note" value="🖥 Meanwhile, someone clicks LED in the dashboard:&#10;POST /toggle/led → hub sets pending_state_update = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="470" y="398" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ka2_req" value="PUT /api/houses/&lt;uid&gt;/keepalive" style="html=1;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="470" as="sourcePoint" />
            <mxPoint x="690" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ka2_resp" value="200 OK&#10;{ alarm: false, state_update: TRUE }" style="html=1;endArrow=open;dashed=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="512" as="sourcePoint" />
            <mxPoint x="210" y="512" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="su_note" value="state_update is TRUE → so the house follows up with a GET" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="270" y="518" width="360" height="20" as="geometry" />
        </mxCell>

        <mxCell id="get_req" value="GET /api/houses/&lt;uid&gt;/state" style="html=1;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="560" as="sourcePoint" />
            <mxPoint x="690" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="get_resp" value="200 OK&#10;{ led:{active:true}, fan:{…},&#10;  buzzer:{…}, motion:{…} }" style="html=1;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontFamily=Courier New;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="610" as="sourcePoint" />
            <mxPoint x="210" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="apply_note" value="🏠 House applies the new state → LED turns ON 💡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="90" y="635" width="320" height="34" as="geometry" />
        </mxCell>

        <!-- FOOTER: alarm note -->
        <mxCell id="footer" value="🔔 The keepalive reply carries a second flag too: if &lt;b&gt;alarm: true&lt;/b&gt;, the house fires its buzzer immediately — no GET needed. So one tiny heartbeat reply can say both &quot;buzz now&quot; and &quot;go pull your new state&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="840" height="50" as="geometry" />
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="leg_req" value="solid = request (house → hub)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="772" width="240" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg_resp" value="dashed = response (hub → house)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="772" width="260" height="18" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
