        <mxCell id="inputsLabel" value="&lt;b&gt;Inputs&lt;/b&gt; (board reads from)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#777777;" vertex="1" parent="1">
