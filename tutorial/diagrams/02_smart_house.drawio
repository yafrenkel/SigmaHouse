        <mxCell id="fan" value="🌀 &lt;b&gt;Fan&lt;/b&gt;&#10;GPIO 18 + 19 (PWM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="140" height="50" as="geometry" />
