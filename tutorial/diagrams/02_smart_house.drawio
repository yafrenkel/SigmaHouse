        <mxCell id="arrow_hub_wifi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0066cc;strokeWidth=3;endArrow=classicThin;startArrow=classicThin;" edge="1" parent="1" source="hub" target="wifi">
