        <mxCell id="outputsLabel" value="&lt;b&gt;Outputs&lt;/b&gt; (board writes to)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- ============= KEY FLOWS BOX ============= -->
        <mxCell id="flowsBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="290" height="220" as="geometry" />
        </mxCell>

        <mxCell id="flowsTitle" value="&lt;b&gt;🔄 Key data flows&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="545" width="290" height="25" as="geometry" />
        </mxCell>

        <mxCell id="flow1" value="&lt;b&gt;1. Dashboard → LED&lt;/b&gt;&#10;hub sets state_update=True&#10;next keepalive returns it&#10;board pulls state, switches LED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="575" width="270" height="60" as="geometry" />
        </mxCell>

        <mxCell id="flow2" value="&lt;b&gt;2. Motion → Alarm everywhere&lt;/b&gt;&#10;PIR IRQ → flag set → loop sees it&#10;board POSTs /report_motion&#10;hub marks every armed house&#10;next keepalive: alarm=true → buzzer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="640" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="flow3" value="&lt;b&gt;3. Button → Dashboard&lt;/b&gt;&#10;Button IRQ → flag → toggle local LED → push_state to hub" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="720" width="270" height="50" as="geometry" />
        </mxCell>

        <!-- ============= LEGEND BOX (right side) ============= -->
        <mxCell id="legendBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="540" width="290" height="220" as="geometry" />
        </mxCell>

        <mxCell id="legendTitle" value="&lt;b&gt;⚡ The IRQ rule&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="545" width="290" height="25" as="geometry" />
        </mxCell>

        <mxCell id="legendText" value="When you press a button or the PIR fires:&#10;&#10;1. Hardware → IRQ handler runs.&#10;2. Handler sets ONE variable:&#10;&#160;&#160;&#160;&#160;self._pressed = True&#10;3. Main loop reads &amp; clears the flag.&#10;&#10;NEVER do print() / sleep / HTTP&#10;inside an IRQ — the board will crash." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="575" width="270" height="180" as="geometry" />
        </mxCell>

      </root>
