        <mxCell id="buzzer" value="🔔 &lt;b&gt;Buzzer&lt;/b&gt;&#10;GPIO 4 (PWM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="280" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="lcd" value="📺 &lt;b&gt;LCD 1602&lt;/b&gt;&#10;I2C @ 0x27&#10;SCL=22, SDA=21" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="360" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- HUB at top -->
        <mxCell id="hub" value="☁️ &lt;b&gt;IoT Hub&lt;/b&gt;&#10;Flask on the counsellor's laptop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;shape=cloud;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="240" height="70" as="geometry" />
