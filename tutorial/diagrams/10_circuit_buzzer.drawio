        </mxCell>
        <mxCell id="esp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#30363d;strokeColor=#111;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=16;" value="&#xa;&#xa;ESP32" vertex="1">
