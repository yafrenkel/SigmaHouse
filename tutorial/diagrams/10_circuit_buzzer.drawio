        <mxCell id="buzz" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d1c4e9;strokeColor=#6a1b9a;fontSize=11;fontStyle=1;" value="🔊&#xa;buzzer&#xa;(piezo disc)" vertex="1">
          <mxGeometry height="76" width="90" x="470" y="150" as="geometry" />
        </mxCell>
        <mxCell id="w2" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="188" />
              <mxPoint x="620" y="298" />
            </Array>
            <mxPoint x="560" y="188" as="sourcePoint" />
            <mxPoint x="246" y="298" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="phys" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4a90d9;fontSize=12;align=left;verticalAlign=middle;spacing=8;" value="⚡ &lt;b&gt;Physics:&lt;/b&gt; inside is a &lt;i&gt;piezo&lt;/i&gt; disc — a material that flexes when voltage is applied. Push-release it fast and it pumps the air, and air pressure waves are what your ears call sound. &lt;b&gt;PWM&lt;/b&gt; (Pulse-Width Modulation) switches GPIO 4 on/off very quickly; the &lt;b&gt;frequency&lt;/b&gt; of that switching = the &lt;b&gt;pitch&lt;/b&gt; (440 times/sec = the note A). Double the frequency = one octave higher. The &lt;b&gt;duty&lt;/b&gt; (the on-fraction &lt;i&gt;within&lt;/i&gt; each cycle) sets the &lt;b&gt;volume &amp; tone&lt;/b&gt; — 50% is loudest, because only the back-and-forth swing makes sound. (How LONG a note plays is a separate thing: the sleep in the code.) That&#39;s the music trick from play_melody.py." vertex="1">
          <mxGeometry height="130" width="760" x="60" y="370" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
