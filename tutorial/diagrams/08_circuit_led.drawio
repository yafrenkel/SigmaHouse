<mxfile host="app.diagrams.net" type="device">
  <diagram name="LED circuit" id="circuit_led">
    <mxGraphModel dx="1000" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;LED circuit&lt;/b&gt;  —  the blinking light (GPIO 12)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="520" height="34" as="geometry" />
        </mxCell>

        <!-- ESP32 -->
        <mxCell id="esp" value="&#10;&#10;ESP32&#10;(the &quot;brain&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#30363d;strokeColor=#111;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="150" height="190" as="geometry" />
        </mxCell>
        <mxCell id="pinGPIO" value="GPIO 12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd966;strokeColor=#bf9000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="186" y="165" width="60" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pinGND" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cccccc;strokeColor=#666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="186" y="285" width="60" height="26" as="geometry" />
        </mxCell>

        <!-- top wire: GPIO -> resistor -->
        <mxCell id="w1" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="246" y="178" as="sourcePoint" /><mxPoint x="300" y="178" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- resistor (zigzag) -->
        <mxCell id="rzig" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="178" as="sourcePoint" />
            <mxPoint x="420" y="178" as="targetPoint" />
            <Array as="points">
              <mxPoint x="312" y="178"/><mxPoint x="322" y="163"/><mxPoint x="340" y="193"/>
              <mxPoint x="358" y="163"/><mxPoint x="376" y="193"/><mxPoint x="394" y="163"/>
              <mxPoint x="408" y="193"/><mxPoint x="416" y="178"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rlabel" value="resistor&#10;220 Ω" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="318" y="118" width="90" height="34" as="geometry" />
        </mxCell>

        <!-- wire resistor -> LED -->
        <mxCell id="w2" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="420" y="178" as="sourcePoint" /><mxPoint x="470" y="178" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- LED = triangle (anode) + bar (cathode) -->
        <mxCell id="ledtri" value="" style="triangle;html=1;direction=east;fillColor=#ff5b5b;strokeColor=#a80000;" vertex="1" parent="1">
          <mxGeometry x="470" y="160" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ledbar" value="" style="rounded=0;fillColor=#a80000;strokeColor=#a80000;html=1;" vertex="1" parent="1">
          <mxGeometry x="506" y="154" width="5" height="48" as="geometry" />
        </mxCell>
        <mxCell id="lightA" style="endArrow=classicThin;html=1;strokeWidth=2;strokeColor=#f6ae2d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="492" y="158" as="sourcePoint" /><mxPoint x="516" y="132" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lightB" style="endArrow=classicThin;html=1;strokeWidth=2;strokeColor=#f6ae2d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="504" y="160" as="sourcePoint" /><mxPoint x="530" y="138" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ledlabel" value="LED&#10;(+ leg = long, on the flat/triangle side)" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#a80000;" vertex="1" parent="1">
          <mxGeometry x="428" y="206" width="160" height="34" as="geometry" />
        </mxCell>

        <!-- wire LED -> corner -> down -> back to GND -->
        <mxCell id="w3" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="511" y="178" as="sourcePoint" /><mxPoint x="246" y="298" as="targetPoint" />
            <Array as="points"><mxPoint x="660" y="178"/><mxPoint x="660" y="298"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- current arrow -->
        <mxCell id="curr" value="current flows only when GPIO 12 is HIGH (3.3 V)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#e07000;fontColor=#e07000;fontSize=11;fontStyle=1;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="90" as="sourcePoint" /><mxPoint x="470" y="90" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- physics callout -->
        <mxCell id="phys" value="⚡ &lt;b&gt;Physics:&lt;/b&gt; the pin is a tiny switch. HIGH puts 3.3 V across the loop, so current flows GPIO 12 → resistor → LED → GND and the LED glows. An LED is a &lt;i&gt;diode&lt;/i&gt;: current one way only, and it drops ~2 V. Without the 220 Ω resistor the current would spike and burn it out — the resistor limits current to a safe ~6 mA (Ohm's law: I = V ÷ R). &quot;Blinking&quot; is just the code flipping the pin HIGH/LOW fast." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4a90d9;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="760" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
