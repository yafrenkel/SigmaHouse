<mxfile host="app.diagrams.net" type="device">
  <diagram name="Fan circuit" id="circuit_fan">
    <mxGraphModel dx="1000" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Fan circuit&lt;/b&gt;  —  spinning a motor (GPIO 18 &amp; 19 → driver → motor)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="10" width="660" height="34" as="geometry" />
        </mxCell>

        <!-- ESP32 -->
        <mxCell id="esp" value="&#10;&#10;ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#30363d;strokeColor=#111;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="140" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pinA" value="GPIO 18 (IN A)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd966;strokeColor=#bf9000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="166" y="185" width="94" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pinB" value="GPIO 19 (IN B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd966;strokeColor=#bf9000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="166" y="235" width="94" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pinGND" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cccccc;strokeColor=#666;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="166" y="300" width="60" height="24" as="geometry" />
        </mxCell>

        <!-- control wires to driver -->
        <mxCell id="wa" value="control signal" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#e07000;fontColor=#e07000;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="260" y="197" as="sourcePoint" /><mxPoint x="360" y="197" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="wb" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#e07000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="260" y="247" as="sourcePoint" /><mxPoint x="360" y="247" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="wgnd" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="226" y="312" as="sourcePoint" /><mxPoint x="360" y="300" as="targetPoint" />
            <Array as="points"><mxPoint x="320" y="312"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="gndshare" value="shared GND" style="text;html=1;fontSize=9;fontColor=#666;align=center;" vertex="1" parent="1">
          <mxGeometry x="262" y="314" width="70" height="16" as="geometry" />
        </mxCell>

        <!-- motor driver / H-bridge -->
        <mxCell id="driver" value="&#10;MOTOR DRIVER&#10;(H-bridge)&#10;&#10;a tiny switch-board:&#10;small signal in →&#10;big power out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="150" width="160" height="200" as="geometry" />
        </mxCell>

        <!-- external power into driver -->
        <mxCell id="power" value="🔋 external power&#10;(battery / USB 5 V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="powerw" value="big current" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#e65100;fontColor=#e65100;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="380" as="sourcePoint" /><mxPoint x="440" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- driver -> motor (two wires) -->
        <mxCell id="mwa" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="210" as="sourcePoint" /><mxPoint x="640" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mwb" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="290" as="sourcePoint" /><mxPoint x="640" y="270" as="targetPoint" />
            <Array as="points"><mxPoint x="600" y="290"/><mxPoint x="600" y="270"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- motor -->
        <mxCell id="motor" value="M&#10;🌀&#10;fan motor" style="ellipse;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="spin" value="spins! (reverse the two&#10;signals → spins the other way)" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="180" height="34" as="geometry" />
        </mxCell>

        <!-- physics callout -->
        <mxCell id="phys" value="⚡ &lt;b&gt;Physics:&lt;/b&gt; a motor is a coil of wire that becomes an electromagnet and spins against magnets. It needs FAR more current than a GPIO pin can safely give (a pin gives a whisper; a motor wants a shout), and when it spins it kicks voltage back (&quot;back-EMF&quot;) that would fry the ESP32. So the pin never powers the motor directly. Instead GPIO 18/19 send tiny &lt;b&gt;control signals&lt;/b&gt; to a &lt;b&gt;motor driver (H-bridge)&lt;/b&gt;, which uses its own power supply to push the big current. A=on,B=off spins one way; swap them to reverse; PWM sets the speed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4a90d9;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="800" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
